<Window x:Class="chat_part2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bot"
        Height="620"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="black">

    <Grid>

        <Border Width="850"
                Height="560"
                Background="Navy"
                CornerRadius="22"
                Padding="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

               
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                 
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="15,0,0,0">
                                

                        <TextBlock Text="REA-BOT"
                                   FontSize="60"
                                   HorizontalAlignment="LEFT"
                                   FontWeight="Bold"
                                   Foreground="black"
                                   />

                        
                    </StackPanel>

                  
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button Content="Task"
                                Width="100"
                                Height="40"
                                Margin="0,0,10,0"
                                Background="black"
                                Foreground="White"
                                BorderThickness="0" Click="OpenTasks_Click"/>

                        <Button Content="Quize"
                                Width="100"
                                Height="40"
                                Background="black"
                                Foreground="White"
                                BorderThickness="0" Click="OpenQuiz_Click"/>
                    </StackPanel>

                </Grid>

            
                <Border Grid.Row="1"
                        Background="Gray"
                        CornerRadius="16"
                        Padding="12"
                        Margin="0,10,0,10">

                    <RichTextBox x:Name="txtChat"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontSize="14"/>
                </Border>

              
                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="Gray"
                            CornerRadius="14"
                            Margin="0,0,10,0">

                        <TextBox x:Name="txtMessage"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontSize="14"
                                 Padding="15"
                                 VerticalContentAlignment="Center"/>
                    </Border>

                    <Button Grid.Column="1"
                            Content="Send"
                            Background="Green"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Button_Click">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="14">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>

                    </Button>

                </Grid>

            </Grid>
        </Border>

    </Grid>
</Window>